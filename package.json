{
  "name": "curso-node-cucei",
  "private": true,
  "type": "module",
  "description": "Curso de Node.js para Ingeniería en Computación (CUCEI), de cero a nivel profesional.",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "sitio"
  ],
  "scripts": {
    "dev": "npm run dev -w sitio",
    "build": "npm run build -w sitio",
    "preview": "npm run preview -w sitio",
    "test": "node scripts/probar.js",
    "test:soluciones": "node scripts/probar-soluciones.js",
    "test:proyecto": "node scripts/probar-proyecto.js",
    "verificar": "node scripts/verificar-ejemplos.js",
    "nuevo-ejercicio": "node scripts/nuevo-ejercicio.js",
    "lint": "eslint .",
    "formato": "prettier --write .",
    "formato:revisar": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.9"
  }
}
